# Beispiel-Einstellungen. Kopieren nach app.env (liegt NICHT im Repository) und anpassen.
# Geheimnisse (Passwörter, Zertifikate) nie ins Repository!

# --- KIS (Standard: lokales Schein-KIS) ---
KIS_FHIR_BASIS_URL=http://localhost:8080/fhir
#KIS_FHIR_TOKEN=            # nur falls das KIS einen Zugangstoken verlangt

# --- Anwendung ---
MELDE_HOST=127.0.0.1
MELDE_PORT=8000
MELDE_TESTBETRIEB=1                 # 0 nur im Echtbetrieb (dann MELDE_BENUTZER/LDAP Pflicht)
#MELDE_BENUTZER=testarzt:test;zweiter:anderespasswort   # NUR Testbetrieb; Echtbetrieb: LDAP (Phase 7)
MELDE_AUDIT_LOG=data/audit.log      # enthält nur Vorgangs-ID, Zeit, Benutzer, Meldeweg, Status
#MELDE_COOKIE_SICHER=1              # 1, sobald die Anwendung über HTTPS erreichbar ist

# --- Meldungsprüfer (Validator); leer = wird beim Start selbst gestartet ---
#VALIDATOR_URL=http://localhost:8090
